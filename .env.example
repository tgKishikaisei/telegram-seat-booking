# Скопируйте в .env и заполните. Файл .env в git не попадает.
# НА СЕРВЕРЕ секреты — файлами в secrets/ (bot_token, ticket_secret), в .env их быть не должно.

# --- Секреты ---
BOT_TOKEN=
# Случайная строка от 32 символов: подпись счетов и QR-кодов билетов (openssl rand -hex 32)
TICKET_SECRET=

# --- Мини-приложение ---
# HTTPS-адрес, где работает веб-часть (в Docker его обслуживает Caddy: DOMAIN ниже)
PUBLIC_URL=https://tickets.example.com
DOMAIN=tickets.example.com
ACME_EMAIL=admin@example.com

# --- Зал ---
TIMEZONE=Asia/Tashkent
HOLD_MINUTES=10
REMINDER_HOURS=3
# Контролёры на входе (Telegram ID через запятую) — сканируют QR в мини-приложении
STAFF_IDS=
ADMIN_IDS=

# --- Инфраструктура (локально; в docker-compose.yml задаётся автоматически) ---
DATABASE_URL=sqlite+aiosqlite:///data/seats.db
# REDIS_URL=redis://localhost:6379/0
LOG_LEVEL=INFO
JSON_LOGS=false
